<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      spacing="15.0"
      prefWidth="400.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="main-container"
      stylesheets="@auth.css"
      fx:controller="dontbesoloud.auth.AuthController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label fx:id="titleLabel" text="Авторизация" styleClass="title"/>


    <GridPane vgap="10"
              hgap="10"
              alignment="CENTER"
              maxWidth="500">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES"
                               minWidth="100.0"
                               prefWidth="100.0"
                               halignment="RIGHT"
            />
            <ColumnConstraints hgrow="NEVER"
                               minWidth="300.0"
                               prefWidth="300.0"
                               halignment="CENTER"
            />
            <ColumnConstraints hgrow="SOMETIMES"
                               minWidth="100.0"
                               prefWidth="100.0"
                               halignment="LEFT"
            />
        </columnConstraints>

        <Label fx:id="nameLabel"
               text="Имя:"
               GridPane.rowIndex="0"
               visible="false"
               managed="false"/>
        <TextField fx:id="nameField"
                   promptText="Введите ваше имя"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"
                   visible="false"
                   managed="false"
                   styleClass="text-field"
        />

        <Label text="Email:" GridPane.rowIndex="1"/>
        <TextField fx:id="emailField"
                   promptText="example@mail.com"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"
                   styleClass="text-field"
        />

        <Label text="Пароль:" GridPane.rowIndex="2"/>
        <PasswordField fx:id="passwordField"
                       promptText="••••••••"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       styleClass="password-field"
                       style="-fx-font-size: 18px;"
        />
    </GridPane>

    <VBox spacing="10.0" alignment="CENTER">
        <Button fx:id="mainButton" text="ВОЙТИ" onAction="#submitAction"
                maxWidth="-Infinity"
                styleClass="button"/>
        <Label fx:id="authError"
               text="Ошибка. Неверная почта или пароль."
               visible="false"
               managed="false">
        </Label>

        <Hyperlink fx:id="switchLink"
                   text="Нет аккаунта? Зарегистрироваться"
                   onAction="#toggleAuth"/>
    </VBox>
</VBox>
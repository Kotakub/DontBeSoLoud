<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="main-container"
      stylesheets="@auth.css"
      fx:controller="dontbesoloud.auth.AuthController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label fx:id="titleLabel" text="Авторизация" styleClass="title-label"/>

    <GridPane vgap="15" hgap="15" alignment="CENTER" maxWidth="-Infinity">
        <VBox.margin>
            <Insets right="95.0"/>
        </VBox.margin>

        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" halignment="RIGHT"
                               minWidth="80.0"/>
            <ColumnConstraints hgrow="NEVER" prefWidth="250.0" maxWidth="250.0"
                               halignment="LEFT"/>
        </columnConstraints>

        <Label text="Имя:" fx:id="nameLabel" visible="false" managed="false"
               styleClass="field-label" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField"
                   promptText="Введите ваше имя"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"
                   visible="false"
                   managed="false"
                   styleClass="custom-text-field"/>

        <Label text="Email:" styleClass="field-label" GridPane.rowIndex="1"/>
        <TextField fx:id="emailField"
                   promptText="example@mail.com"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"
                   styleClass="custom-text-field"/>

        <Label text="Пароль:" styleClass="field-label" GridPane.rowIndex="2"/>
        <PasswordField fx:id="passwordField"
                       promptText="••••••••"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       styleClass="custom-text-field"/>
    </GridPane>

    <VBox spacing="20.0" alignment="CENTER" maxWidth="-Infinity">
        <Button fx:id="mainButton" text="ВОЙТИ" onAction="#submitAction"
                prefWidth="250" styleClass="main-button"/>

        <Label fx:id="authError"
               text="Ошибка. Неверная почта или пароль."
               visible="false"
               managed="false"
               styleClass="error-label"/>

        <Hyperlink fx:id="switchLink"
                   text="Нет аккаунта? Зарегистрироваться"
                   onAction="#toggleAuth"
                   styleClass="custom-link"/>
    </VBox>

</VBox>
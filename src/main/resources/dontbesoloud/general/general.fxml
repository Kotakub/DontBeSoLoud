<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/17"
           fx:controller="dontbesoloud.general.GeneralController"
           stylesheets="@general.css">
    <GridPane>
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="250.0" maxWidth="250.0"/>
            <ColumnConstraints hgrow="ALWAYS" halignment="LEFT"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <fx:include GridPane.columnIndex="0" source="../sidebar/sidebar.fxml"/>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                GridPane.columnIndex="1"
                styleClass="content-scroll">
            <FlowPane fx:id="groupsContainer"
                      styleClass="groups-grid"
                      hgap="20.0"
                      vgap="20.0">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                </padding>
                <Button fx:id="addGroupButton" text="Добавить курс"
                        onAction="#showAddGroupLayer"
                        styleClass="add-group-button"/>
            </FlowPane>
        </ScrollPane>
    </GridPane>

    <VBox fx:id="addGroupLayer"
          visible="false"
          managed="false"
          alignment="CENTER"
          maxWidth="Infinity"
          maxHeight="Infinity"
          styleClass="modal-overlay">

        <VBox spacing="20" alignment="CENTER" maxWidth="450"
              styleClass="modal-window">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30"/>
            </padding>

            <VBox spacing="10" alignment="CENTER">
                <StackPane styleClass="image-upload-container">
                    <ImageView fx:id="groupImage" fitHeight="150" fitWidth="250"
                               preserveRatio="true"/>
                    <Button text="Выбрать фото" onAction="#сhooseImage"
                            styleClass="secondary-button"/>
                </StackPane>
            </VBox>

            <VBox spacing="8">
                <TextField fx:id="groupNameField"
                           promptText="Например: Основы жестового языка"
                           styleClass="custom-text-field"/>
            </VBox>

            <HBox spacing="20" alignment="CENTER" styleClass="modal-actions">
                <Button text="Удалить" onAction="#deleteGroup"
                        styleClass="danger-button"/>
                <Button text="Отмена" onAction="#hideAddGroupLayer"
                        styleClass="cancel-button"/>
                <Button text="Сохранить" onAction="#saveGroup"
                        styleClass="confirm-button"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>

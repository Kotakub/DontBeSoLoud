<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dontbesoloud.general.LessonsController"
      stylesheets="@lessons.css"
      styleClass="lessons-root">

    <fx:include source="../sidebar/sidebar.fxml"/>

    <BorderPane HBox.hgrow="ALWAYS" styleClass="content-pane">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <left>
            <VBox minWidth="180" maxWidth="180" alignment="CENTER" spacing="15">
                <Button fx:id="deleteButton" text="УДАЛИТЬ"
                        onAction="#deleteLesson"
                        styleClass="control-button, danger-button"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="prevButton" text="НАЗАД" onAction="#prevLesson"
                        styleClass="nav-button"/>
            </VBox>
        </left>

        <center>
            <StackPane styleClass="main-workspace">
                <GridPane fx:id="selectionLayer" hgap="20" vgap="20"
                          alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" halignment="CENTER"
                                           percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" halignment="CENTER"
                                           percentWidth="50"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints valignment="CENTER"/>
                    </rowConstraints>

                    <VBox onMouseClicked="#addTheoryLayer"
                          GridPane.columnIndex="0" GridPane.rowIndex="0"
                          alignment="CENTER" styleClass="selection-card">
                        <Label text="Теория" styleClass="selection-label"/>
                    </VBox>

                    <VBox onMouseClicked="#addPracticeLayer"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"
                          alignment="CENTER" styleClass="selection-card">
                        <Label text="Практика" styleClass="selection-label"/>
                    </VBox>
                </GridPane>

                <VBox fx:id="theoryLayer"
                      visible="false"
                      managed="false"
                      alignment="CENTER"
                      spacing="20"
                      styleClass="workspace-layer">
                    <StackPane fx:id="photoUploadBox"
                               onMouseClicked="#loadPhoto"
                               styleClass="photo-upload-box">
                        <Label text="Нажмите для загрузки фото"
                               styleClass="upload-prompt"/>
                        <ImageView fx:id="theoryImage"
                                   fitWidth="500"
                                   preserveRatio="true"
                                   styleClass="theory-image"/>
                    </StackPane>
                    <TextArea fx:id="theoryText"
                              
                              editable="false"
                              wrapText="true"
                              styleClass="theory-textarea"/>
                </VBox>

                <VBox fx:id="practiceLayer" visible="false" managed="false"
                      alignment="CENTER" spacing="20">
                    <StackPane styleClass="camera-container">
                        <ImageView fx:id="cameraView" fitHeight="350"
                                   fitWidth="500" preserveRatio="true"/>
                    </StackPane>
                    <HBox alignment="CENTER" spacing="10">
                        <Label text="Распознанный жест:"
                               styleClass="status-label"/>
                        <TextField fx:id="equalSign" editable="false" prefWidth="200"
                                   text="Выберите жест"
                                   styleClass="gesture-field"/>
                    </HBox>
                </VBox>
            </StackPane>
        </center>

        <right>
            <VBox minWidth="180" maxWidth="180" alignment="CENTER" spacing="15">
                <Button fx:id="saveButton" text="СОХРАНИТЬ"
                        onAction="#saveLesson"
                        styleClass="control-button, success-button"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="nextButton" text="ВПЕРЕД" onAction="#nextLesson"
                        styleClass="nav-button"/>
            </VBox>
        </right>
    </BorderPane>
</HBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dontbesoloud.general.LessonsController"
      stylesheets="@../main_style.css"
>

    <fx:include source="../sidebar/sidebar.fxml"/>

    <BorderPane HBox.hgrow="ALWAYS">

        <left>
            <VBox minWidth="200" maxWidth="200" alignment="CENTER">
                <Button fx:id="deleteButton" text="УДАЛИТЬ"
                        onAction="#deleteLesson"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="prevButton" text="НАЗАД" onAction="#prevLesson"/>
            </VBox>
        </left>


        <center>
            <StackPane>
                <GridPane fx:id="selectionLayer">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"
                                           halignment="CENTER"
                                           percentWidth="50"/> <!--text + photo-->
                        <ColumnConstraints hgrow="ALWAYS"
                                           halignment="CENTER"
                                           percentWidth="50"/> <!--camera + check-->
                    </columnConstraints>

                    <!--text + photo-->
                    <VBox onMouseClicked="#addTheoryLayer"
                          GridPane.columnIndex="0"
                          alignment="CENTER"
                          minHeight="200"
                    >
                        <Label>Теория</Label>
                    </VBox>


                    <!--camera + check-->
                    <VBox onMouseClicked="#addPracticeLayer"
                          GridPane.columnIndex="1"
                          alignment="CENTER"
                    >
                        <Label>Практика</Label>
                    </VBox>

                </GridPane>


                <VBox fx:id="theoryLayer" visible="false" managed="false"
                      alignment="CENTER" spacing="15">
                    <StackPane onMouseClicked="#loadPhoto"
                               style="-fx-background-color: #ffffff; -fx-border-color: #ccc; -fx-border-style: dashed; -fx-cursor: hand;"
                               minHeight="350" minWidth="450" maxWidth="450">

                        <Label text="Нажмите для загрузки фото"
                               minWidth="450" maxWidth="450"
                               style="-fx-text-fill: #999;"/>

                        <ImageView fx:id="theoryImage" fitWidth="450"/>
                    </StackPane>

                    <TextArea fx:id="theoryText" editable="true" wrapText="true"
                              prefWidth="300"/>
                </VBox>


                <VBox fx:id="practiceLayer" visible="false" managed="false"
                      alignment="CENTER">
                    <ImageView fx:id="cameraView" fitHeight="350" fitWidth="500"
                               preserveRatio="true"/>
                    <HBox alignment="CENTER" spacing="10">
                        <Label text="Распознанный жест: "
                               style="-fx-font-size: 16px; -fx-text-fill: #2E3A2E;"/>
                        <TextField editable="false" prefWidth="250"
                                   style="-fx-background-radius: 10; -fx-font-weight: bold; -fx-text-fill: #388E3C; -fx-background-color: #E8F5E9;"
                                   text="Ожидание..."/>
                    </HBox>
                </VBox>

                <!--            <VBox fx:id="loadPhoto" visible="false" managed="false">-->
                <!--                <VBox>-->
                <!--                </VBox>-->
                <!--            </VBox>-->

                <!--            <VBox fx:id="editText" visible="false" managed="false">-->
                <!--                <VBox>-->
                <!--                </VBox>-->
                <!--            </VBox>-->

            </StackPane>
        </center>


        <right>
            <VBox minWidth="200" maxWidth="200" alignment="CENTER">
                <Button fx:id="saveButton" text="СОХРАНИТЬ"
                        onAction="#saveLesson"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="nextButton" text="ВПЕРЕД"
                        onAction="#nextLesson"/>
            </VBox>
        </right>
    </BorderPane>
</HBox>